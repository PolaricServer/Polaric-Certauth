#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
JAVA_21_BIN := $(shell update-alternatives --list javac 2>/dev/null | grep -E '/(java|temurin)-21-' | head -n1)

ifeq ($(JAVA_21_BIN),)
$(error Could not locate a Java 21 javac alternative)
endif

export JAVA_HOME := $(shell dirname $$(dirname $(JAVA_21_BIN)))
export PATH := $(JAVA_HOME)/bin:$(PATH)

%:
	dh $@

override_dh_auto_build:
	mvn clean dependency:copy-dependencies -DoutputDirectory=target/lib -DincludeScope=runtime package
	$(MAKE) -C client

override_dh_auto_clean:
	mvn clean
	$(MAKE) -C client clean
	dh_auto_clean
